---
const TESTIMONIOS = [
  {
    inicial: "Q",
    color: "#4A90D9",
    nombre: "Quijotes",
    fecha: "2026-10-05",
    texto: "Quedamos muy contentos, muchísima dedicación, calidad y paciencia en la entrega de nuestra invitación para boda, muchas gracias.",
  },
  {
    inicial: "M",
    color: "#7B2D8B",
    nombre: "Maria Sarmiento",
    fecha: "2026-08-25",
    texto: "Quedamos felices con las tarjetas del baby shower de Thomas. La calidad fue excelente, el diseño quedó hermoso y se nota el cuidado en cada detalle. Destaco muchísimo el profesionalismo, la atención y el cumplimiento de los tiempos de entrega. Un trabajo impecable y totalmente recomendado.",
  },
  {
    inicial: "M",
    color: "#00897B",
    nombre: "Mar Corre",
    fecha: "2026-08-25",
    texto: "Trabajo muy bien planificado, buen diseño. Nos encantó nuestra invitación de boda, cumple los tiempos en la entrega y en darnos ideas.",
  },
];
---

<section
  aria-label="Reseñas de clientes en Google"
  style="background-color: #F8F5F0; padding: 5rem 1.5rem;"
>
  <div style="max-width: 56rem; margin: 0 auto;">
    <p
      class="text-sm font-semibold tracking-widest uppercase mb-3 text-center"
      style="color: #7A5C10;"
    >
      Reseñas reales · Google
    </p>
    <h2
      class="text-2xl md:text-3xl font-bold mb-14 text-center"
      style="font-family: 'Playfair Display', serif; color: #5A1B5E;"
    >
      Lo que dicen nuestros clientes
    </h2>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:20px;">
      {TESTIMONIOS.map((t) => (
        <article
          class="testimonio-item flex flex-col gap-4 p-6 rounded-2xl shadow-sm"
          style="background-color: white; border: 1px solid #F0E0E8;"
        >
          <div class="flex items-center gap-3">
            <div
              class="w-11 h-11 rounded-full flex items-center justify-center text-base font-bold flex-shrink-0"
              style={`background-color: ${t.color}; color: #fff;`}
            >
              {t.inicial}
            </div>
            <div>
              <p class="text-sm font-bold" style="color: #3A1140;">{t.nombre}</p>
              <p class="text-xs" style="color: #9b8aa8;" data-fecha={t.fecha}>—</p>
            </div>
          </div>

          <!-- Estrellas SVG -->
          <div style="display:flex; gap:2px;">
            {Array(5).fill(0).map(() => (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#F4B400" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
            <!-- Badge Google -->
            <svg width="15" height="15" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="margin-left:6px;">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </div>

          <p class="text-sm leading-relaxed" style="color: #4A4A4A;">
            "{t.texto}"
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  function fechaRelativa(fechaISO: string): string {
    const ahora = new Date();
    const fecha = new Date(fechaISO);
    const diffMs = ahora.getTime() - fecha.getTime();
    const dias = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    if (dias < 7) return dias === 1 ? "Hace 1 día" : `Hace ${dias} días`;
    const semanas = Math.floor(dias / 7);
    if (semanas < 5) return semanas === 1 ? "Hace 1 semana" : `Hace ${semanas} semanas`;
    const meses = Math.floor(dias / 30);
    if (meses < 12) return meses === 1 ? "Hace 1 mes" : `Hace ${meses} meses`;
    const años = Math.floor(dias / 365);
    return años === 1 ? "Hace 1 año" : `Hace ${años} años`;
  }

  document.querySelectorAll<HTMLElement>("[data-fecha]").forEach((el) => {
    const fecha = el.getAttribute("data-fecha");
    if (fecha) el.textContent = fechaRelativa(fecha);
  });
</script>
