---
import Base from '../../layouts/Base.astro';
import HomePlantillas from '../../components/HomePlantillas';

const templates = [
  { id: "01-dino", nombre: "Baby Shower Dinosaurio", emoji: "🦖", precio: "$70.000 COP", demo: "https://dino.celebrarte.com.co/demo", desc: "Sobre animado con temática de dinosaurios, muro de deseos y RSVP." },
  { id: "02-stork", nombre: "Cigüeña Dulce", emoji: "🦢", precio: "$60.000 COP", demo: "https://stork.celebrarte.com.co/demo", desc: "Diseño tierno de cigüeña y nubes, con cuenta regresiva y mapa." },
  { id: "03-space", nombre: "Aventura Espacial", emoji: "🚀", precio: "$70.000 COP", demo: "https://space.celebrarte.com.co/demo", desc: "Temática espacial con cohetes, estrellas y mapa interactivo." },
];

const schemaLD = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://celebrarte.com.co/baby-shower#page",
      "name": "Invitaciones Digitales Baby Shower | Celebrarte Colombia",
      "description": "Diseños animados de invitaciones para baby shower con RSVP, muro de deseos y mapa interactivo. Desde $60.000 COP, listas el mismo día.",
      "url": "https://celebrarte.com.co/baby-shower",
      "inLanguage": "es-CO",
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://celebrarte.com.co" },
        { "@type": "ListItem", "position": 2, "name": "Baby Shower", "item": "https://celebrarte.com.co/baby-shower" },
      ],
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Cuánto cuesta una invitación digital de baby shower?", "acceptedAnswer": { "@type": "Answer", "text": "Nuestras invitaciones de baby shower están desde $60.000 COP. Incluyen sobre animado, RSVP, muro de deseos, cuenta regresiva y mapa interactivo." } },
        { "@type": "Question", "name": "¿En cuánto tiempo está lista mi invitación?", "acceptedAnswer": { "@type": "Answer", "text": "Normalmente en menos de 24 horas. Recibirás el link listo para compartir por WhatsApp." } },
        { "@type": "Question", "name": "¿Puedo personalizar el nombre del bebé y la fecha?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, completamente. Personalizas nombre, fecha, lugar, mensaje, vestimenta y hasta la canción de fondo." } },
      ],
    },
  ],
};
---

<Base
  title="Invitaciones Digitales Baby Shower | Celebrarte Colombia"
  description="Diseños animados de invitaciones para baby shower con RSVP, muro de deseos y mapa interactivo. Desde $60.000 COP, listas el mismo día."
  canonical="https://celebrarte.com.co/baby-shower"
>
  <slot name="head" slot="head">
    <meta name="keywords" content="invitación digital baby shower, invitación baby shower Colombia, invitación baby shower animada, invitación baby shower online, baby shower invitación WhatsApp" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Celebrarte" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaLD)} />
  </slot>


  <!-- HERO -->
  <section style="background:linear-gradient(135deg,#fdf4ff 0%,#f0e8ff 100%); padding:64px 24px 56px; text-align:center;">
    <p style="font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:0.15em; color:#C49B3A; margin-bottom:12px;">Invitaciones Baby Shower</p>
    <h1 style="font-family:'Playfair Display',serif; font-size:clamp(28px,5vw,46px); font-weight:700; color:#3A1140; margin:0 0 16px; line-height:1.2;">
      Invitaciones Digitales<br/>para Baby Shower
    </h1>
    <p style="font-size:16px; color:#6b5c7a; max-width:520px; margin:0 auto 28px; line-height:1.6;">
      Animadas, interactivas y listas el mismo día. Sobre animado, RSVP, muro de deseos y mapa. Todo en un link que compartes por WhatsApp.
    </p>
    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <a href="/plantillas" style="background:linear-gradient(135deg,#5A1B5E,#7A2E8A); color:#fff; font-weight:800; font-size:15px; padding:13px 28px; border-radius:99px; text-decoration:none; box-shadow:0 4px 20px rgba(90,27,94,0.35);">
        Ver todas las plantillas →
      </a>
      <a href="https://wa.me/573057502790?text=Hola!%20Quiero%20una%20invitaci%C3%B3n%20de%20baby%20shower" target="_blank" rel="noopener" style="border:2px solid #25D366; color:#25D366; font-weight:700; font-size:14px; padding:11px 24px; border-radius:99px; text-decoration:none;">
        Consultar por WhatsApp
      </a>
    </div>
  </section>

  <!-- PLANTILLAS -->
  <section style="max-width:960px; margin:0 auto; padding:56px 24px;">
    <h2 style="font-family:'Playfair Display',serif; font-size:26px; font-weight:700; color:#3A1140; text-align:center; margin-bottom:36px;">
      Nuestros diseños de Baby Shower
    </h2>
    <HomePlantillas client:load categoria="Baby Shower" />
  </section>

  <!-- BENEFICIOS -->
  <section style="background:linear-gradient(135deg,#3A1140,#5A1B5E); padding:56px 24px; text-align:center;">
    <h2 style="font-family:'Playfair Display',serif; font-size:26px; font-weight:700; color:#fff; margin-bottom:12px;">¿Por qué elegir Celebrarte?</h2>
    <p style="color:rgba(255,255,255,0.7); font-size:14px; max-width:480px; margin:0 auto 40px;">Todo lo que necesitas para tu baby shower en un solo link.</p>
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:20px; max-width:800px; margin:0 auto;">
      {[
        { icon:"✉️", title:"Sobre animado", desc:"Tus invitados abren el sobre con una animación especial." },
        { icon:"✅", title:"RSVP incluido", desc:"Confirman asistencia directo desde la invitación." },
        { icon:"💬", title:"Muro de deseos", desc:"Los invitados dejan mensajes para el bebé en tiempo real." },
        { icon:"🗺️", title:"Mapa interactivo", desc:"Ubicación del evento con un clic." },
        { icon:"📱", title:"Listo en 24h", desc:"Recibes tu link listo para compartir por WhatsApp." },
        { icon:"🎵", title:"Música de fondo", desc:"Elige la canción que ambienta tu invitación." },
      ].map(b => (
        <div style="background:rgba(255,255,255,0.07); border-radius:16px; padding:20px; text-align:center;">
          <div style="font-size:28px; margin-bottom:8px;">{b.icon}</div>
          <h3 style="font-size:14px; font-weight:800; color:#fff; margin:0 0 4px;">{b.title}</h3>
          <p style="font-size:12px; color:rgba(255,255,255,0.6); margin:0; line-height:1.4;">{b.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section style="max-width:680px; margin:0 auto; padding:56px 24px;">
    <h2 style="font-family:'Playfair Display',serif; font-size:24px; font-weight:700; color:#3A1140; text-align:center; margin-bottom:32px;">Preguntas frecuentes</h2>
    <div style="display:flex; flex-direction:column; gap:16px;">
      {[
        { q:"¿Cuánto cuesta una invitación de baby shower?", a:"Desde $60.000 COP. El precio varía según el diseño elegido. Incluye todas las funciones: RSVP, muro de deseos, cuenta regresiva y mapa." },
        { q:"¿En cuánto tiempo está lista?", a:"Normalmente en menos de 24 horas después de confirmar el pago. Recibes un link único para compartir por WhatsApp." },
        { q:"¿Puedo personalizar el nombre del bebé y los colores?", a:"Sí. Personalizas nombre, fecha, lugar, mensaje de bienvenida, vestimenta y canción de fondo." },
        { q:"¿Cómo la comparto con los invitados?", a:"Recibes un link único. Lo copias y lo mandas por WhatsApp, Instagram o como quieras. Cada invitado lo abre desde su celular." },
      ].map(faq => (
        <details style="background:#fff; border:1px solid #ede0f5; border-radius:14px; padding:16px 20px; cursor:pointer;">
          <summary style="font-size:14px; font-weight:700; color:#1A0A20; list-style:none;">{faq.q}</summary>
          <p style="font-size:13px; color:#6b5c7a; margin:10px 0 0; line-height:1.6;">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA FINAL -->
  <section style="text-align:center; padding:40px 24px 64px;">
    <a href="/plantillas"
      style="background:linear-gradient(135deg,#5A1B5E,#7A2E8A); color:#fff; font-weight:800; font-size:16px; padding:16px 36px; border-radius:99px; text-decoration:none; display:inline-block; box-shadow:0 6px 24px rgba(90,27,94,0.35);">
      Elegir mi plantilla de baby shower →
    </a>
  </section>
</Base>
