---
import Base from '../../layouts/Base.astro';
import HomePlantillas from '../../components/HomePlantillas';

const templates = [
  { id: "04-Moderna", nombre: "Boda Moderna", emoji: "💍", precio: "$80.000 COP", demo: "https://boda-moderna.celebrarte.com.co/demo", desc: "Sobre animado con sello de cera, música, RSVP, mapa y libro de firmas digital." },
];

const schemaLD = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://celebrarte.com.co/boda#page",
      "name": "Invitaciones Digitales de Boda | Celebrarte Colombia",
      "description": "Invitaciones digitales de boda animadas con sobre interactivo, RSVP, mapa y libro de firmas. Desde $80.000 COP, lista en 24h.",
      "url": "https://celebrarte.com.co/boda",
      "inLanguage": "es-CO",
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://celebrarte.com.co" },
        { "@type": "ListItem", "position": 2, "name": "Boda", "item": "https://celebrarte.com.co/boda" },
      ],
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Cuánto cuesta una invitación digital de boda?", "acceptedAnswer": { "@type": "Answer", "text": "Nuestra invitación de boda está desde $80.000 COP. Incluye sobre animado con sello de cera, música personalizada, RSVP, cuenta regresiva, mapa y libro de firmas digital." } },
        { "@type": "Question", "name": "¿Puedo personalizar los nombres y la fecha de la boda?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. Personalizas los nombres de los novios, fecha, hora, lugar de ceremonia y recepción, vestimenta y canción de fondo." } },
        { "@type": "Question", "name": "¿Los invitados pueden confirmar asistencia desde la invitación?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, la invitación incluye RSVP integrado y un libro de firmas digital donde los invitados dejan sus mensajes." } },
      ],
    },
  ],
};
---

<Base
  title="Invitaciones Digitales de Boda | Celebrarte Colombia"
  description="Invitaciones digitales de boda animadas con sobre interactivo, RSVP, mapa y libro de firmas. Desde $80.000 COP, lista en 24h."
  canonical="https://celebrarte.com.co/boda"
>
  <slot name="head" slot="head">
    <meta name="keywords" content="invitación digital boda, invitación boda Colombia, invitación matrimonio animada, invitación digital matrimonio, invitación boda WhatsApp" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Celebrarte" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaLD)} />
  </slot>



  <!-- HERO -->
  <section style="background:linear-gradient(135deg,#f9f4f0 0%,#f0ead8 100%); padding:64px 24px 56px; text-align:center;">
    <p style="font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:0.15em; color:#C49B3A; margin-bottom:12px;">Invitaciones de Boda</p>
    <h1 style="font-family:'Playfair Display',serif; font-size:clamp(28px,5vw,46px); font-weight:700; color:#3A1140; margin:0 0 16px; line-height:1.2;">
      Invitación Digital<br/>de Boda Elegante
    </h1>
    <p style="font-size:16px; color:#6b5c7a; max-width:520px; margin:0 auto 28px; line-height:1.6;">
      Sobre animado con sello de cera, música personalizada, RSVP, mapa de ceremonia y libro de firmas digital. Todo en un link para compartir por WhatsApp.
    </p>
    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <a href="/plantillas" style="background:linear-gradient(135deg,#3A1140,#5A1B5E); color:#fff; font-weight:800; font-size:15px; padding:13px 28px; border-radius:99px; text-decoration:none; box-shadow:0 4px 20px rgba(58,17,64,0.35);">
        Ver plantilla de boda →
      </a>
      <a href="https://wa.me/573057502790?text=Hola!%20Quiero%20una%20invitaci%C3%B3n%20digital%20de%20boda" target="_blank" rel="noopener" style="border:1.5px solid #5A1B5E; color:#5A1B5E; font-weight:700; font-size:14px; padding:11px 24px; border-radius:99px; text-decoration:none; display:inline-flex; align-items:center; gap:8px; background:transparent;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.555 4.116 1.524 5.849L.057 23.617a.75.75 0 0 0 .92.92l5.694-1.48A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.944 9.944 0 0 1-5.072-1.384l-.364-.215-3.777.982.999-3.671-.236-.378A9.944 9.944 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        Consultar por WhatsApp
      </a>
    </div>
  </section>

  <!-- PLANTILLAS -->
  <section style="max-width:960px; margin:0 auto; padding:56px 24px;">
    <h2 style="font-family:'Playfair Display',serif; font-size:26px; font-weight:700; color:#3A1140; text-align:center; margin-bottom:36px;">
      Diseño de Boda Disponible
    </h2>
    <HomePlantillas client:load categoria="Boda" />
  </section>

  <!-- BENEFICIOS -->
  <section style="background:linear-gradient(135deg,#3A1140,#5A1B5E); padding:56px 24px; text-align:center;">
    <h2 style="font-family:'Playfair Display',serif; font-size:26px; font-weight:700; color:#fff; margin-bottom:12px;">Todo para el gran día</h2>
    <p style="color:rgba(255,255,255,0.7); font-size:14px; max-width:480px; margin:0 auto 40px;">Una invitación digital que sorprende a tus invitados desde el primer segundo.</p>
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:20px; max-width:800px; margin:0 auto;">
      {[
        { svg: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>`, title:"Sobre con sello de cera", desc:"Animación exclusiva que enamora al abrir la invitación." },
        { svg: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`, title:"Música de fondo", desc:"Elige la canción que ambienta su historia de amor." },
        { svg: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`, title:"RSVP digital", desc:"Los invitados confirman asistencia desde el link." },
        { svg: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>`, title:"Mapa de ceremonia", desc:"Ubicación de ceremonia y recepción con un clic." },
        { svg: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`, title:"Libro de firmas", desc:"Muro de mensajes y buenos deseos en tiempo real." },
        { svg: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`, title:"Cuenta regresiva", desc:"Cronómetro en vivo hasta el día del matrimonio." },
      ].map(b => (
        <div style="background:rgba(255,255,255,0.07); border-radius:16px; padding:20px; text-align:center;">
          <div style="display:flex; justify-content:center; margin-bottom:10px;" set:html={b.svg} />
          <h3 style="font-size:14px; font-weight:800; color:#fff; margin:0 0 4px;">{b.title}</h3>
          <p style="font-size:12px; color:rgba(255,255,255,0.6); margin:0; line-height:1.4;">{b.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section style="max-width:680px; margin:0 auto; padding:56px 24px;">
    <h2 style="font-family:'Playfair Display',serif; font-size:24px; font-weight:700; color:#3A1140; text-align:center; margin-bottom:32px;">Preguntas frecuentes</h2>
    <div style="display:flex; flex-direction:column; gap:16px;">
      {[
        { q:"¿Cuánto cuesta la invitación digital de boda?", a:"Desde $80.000 COP. Incluye sobre animado con sello de cera, música personalizada, RSVP, cuenta regresiva, mapa de ceremonia y recepción, y libro de firmas digital." },
        { q:"¿Puedo personalizar el diseño con nuestros nombres?", a:"Sí. Personalizas los nombres de los novios, fecha, hora, lugar de ceremonia, lugar de recepción, vestimenta y canción de fondo." },
        { q:"¿Los invitados confirman asistencia desde la invitación?", a:"Sí. La invitación incluye RSVP integrado y un libro de firmas digital donde los invitados dejan mensajes y buenos deseos." },
        { q:"¿En cuánto tiempo tengo mi invitación lista?", a:"Normalmente en menos de 48 horas tras confirmar el pedido. Te entregamos el link listo para compartir por WhatsApp o redes sociales." },
      ].map(faq => (
        <details style="background:#fff; border:1px solid #ede0f5; border-radius:14px; padding:16px 20px; cursor:pointer;">
          <summary style="font-size:14px; font-weight:700; color:#1A0A20; list-style:none;">{faq.q}</summary>
          <p style="font-size:13px; color:#6b5c7a; margin:10px 0 0; line-height:1.6;">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA FINAL -->
  <section style="text-align:center; padding:40px 24px 64px;">
    <a href="/plantillas"
      style="background:linear-gradient(135deg,#3A1140,#5A1B5E); color:#fff; font-weight:800; font-size:16px; padding:16px 36px; border-radius:99px; text-decoration:none; display:inline-block; box-shadow:0 6px 24px rgba(58,17,64,0.35);">
      Personalizar mi invitación de boda →
    </a>
  </section>
</Base>
