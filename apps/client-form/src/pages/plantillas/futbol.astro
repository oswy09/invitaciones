---
import Base from '../../layouts/Base.astro';

const slug = 'futbol';
const nombre = 'Cumpleaños Futbolero';
const descripcion = 'Invitación digital de cumpleaños temática de fútbol: carta de jugador estilo Mundial, grama animada, datos del evento y confirmación de asistencia. Comparte por WhatsApp al instante.';
const canonical = `https://celebrarte.com.co/plantillas/${slug}`;
const ogImage = 'https://res.cloudinary.com/ddqbnr9vo/image/upload/v1785889536/edit-this-cartoon-soccer-player-image-add-a-colorf_cdbven.webp';
---

<Base
  title={`Invitación Cumpleaños Fútbol - Plantilla Futbolero | Celebrarte`}
  description={descripcion}
  canonical={canonical}
  ogImage={ogImage}
>
  <slot name="head" slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": `${canonical}#page`,
          "name": `Invitación Cumpleaños Fútbol | Celebrarte`,
          "description": descripcion,
          "url": canonical,
          "inLanguage": "es-CO",
          "publisher": { "@id": "https://celebrarte.com.co#org" },
        },
        {
          "@type": "Product",
          "name": `Plantilla ${nombre}`,
          "description": descripcion,
          "image": ogImage,
          "brand": { "@type": "Brand", "name": "Celebrarte" },
          "offers": {
            "@type": "Offer",
            "price": "70000",
            "priceCurrency": "COP",
            "availability": "https://schema.org/InStock",
            "seller": { "@type": "Organization", "name": "Celebrarte" }
          }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://celebrarte.com.co" },
            { "@type": "ListItem", "position": 2, "name": "Plantillas", "item": "https://celebrarte.com.co/plantillas" },
            { "@type": "ListItem", "position": 3, "name": nombre, "item": canonical }
          ]
        }
      ]
    })} />
  </slot>

  <!-- CTA encima del demo -->
  <div style="background:#0d2e0d;padding:16px;text-align:center;">
    <a
      href="https://wa.me/573057502790?text=Hola!%20Quiero%20solicitar%20la%20plantilla%20*Cumplea%C3%B1os%20Futbolero*"
      target="_blank"
      style="display:inline-block;background:linear-gradient(135deg,#5A1B5E,#7A2E8A);color:#fff;font-weight:700;padding:11px 28px;border-radius:999px;text-decoration:none;font-size:14px;"
    >
      Solicitar este diseño 💬
    </a>
  </div>

  <!-- Demo embebida: SPA de React servida como estático -->
  <iframe
    src="/demos/futbol/index.html"
    title={`Demo ${nombre}`}
    style="width:100%;height:100dvh;border:none;display:block;"
    loading="lazy"
  ></iframe>
</Base>
